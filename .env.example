OLLAMA_BASE_URL=http://localhost:11434
#PLANNER_MODEL=gemma4:26b
PLANNER_MODEL=llama3.1:latest
CODER_MODEL=qwen2.5-coder:7b
REVIEWER_MODEL=llama3.1:latest
# Seconds to wait on a single Ollama call. Cocotb generation can exceed 300.
LLM_TIMEOUT=900
MOCK_EDA=false
LLM_PLANNER_ENABLED=false
LLM_CODEGEN_ENABLED=false
MAX_RETRIES=3
WORKSPACE_ROOT=./runs
SIMULATION_TIMEOUT_SECONDS=60
OPENSTA_LIBERTY_PATH=/absolute/path/to/standard-cell.lib
OPENROAD_TECH_LEF_PATH=/absolute/path/to/technology.lef
OPENROAD_CELL_LEF_PATH=/absolute/path/to/standard-cell.lef
OPENROAD_CELL_GDS_PATH=/absolute/path/to/standard-cell.gds
OPENROAD_GDS_MAP_PATH=/absolute/path/to/gds-layer.map
OPENROAD_SDC_PATH=
OPENROAD_CLOCK_BUFFER=sky130_fd_sc_hd__clkbuf_1
OPENROAD_CONGESTION_ITERATIONS=10
OPENROAD_PATH=/absolute/path/to/openroad
KLAYOUT_TECH_FILE=/absolute/path/to/sky130A.lyt
KLAYOUT_LAYER_PROPERTIES=/absolute/path/to/sky130A.lyp
KLAYOUT_STREAM_OUT_SCRIPT=/absolute/path/to/openlane/stream_out.py
KLAYOUT_CONTAINER_IMAGE=docker.io/efabless/openlane:latest
KLAYOUT_CONTAINER_RUNTIME=podman
MAGIC_TECH_PATH=/absolute/path/to/sky130A/libs.tech/magic
LVS_REFERENCE_SPICE=/absolute/path/to/reference.spice
LVS_EXTRACTED_SPICE=/absolute/path/to/extracted.spice
NETGEN_SETUP_PATH=/absolute/path/to/sky130A/libs.tech/netgen/sky130A_setup.tcl

# Neo4j graph + GraphQL
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Optional Neo4j graph + GraphQL
# NEO4J_URI=neo4j://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-password
# NEO4J_DATABASE=neo4j

# Hybrid RAG: SQLite/FTS5 + Qdrant semantic search
RAG_VECTOR_ENABLED=true
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=eda_experience
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
YOSYS_GENERATE_GRAPH=true
LVS_ENABLED=false
